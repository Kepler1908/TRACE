# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default LLM Configuration (DeepSeek is the default)
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=deepseek/deepseek-v4-flash

# llama.cpp Configuration (local OpenAI-compatible server)
# DEFAULT_LLM_PROVIDER=llama_cpp
# DEFAULT_LLM_MODEL=Jackrong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-GGUF
# LLAMA_CPP_BASE_URL=http://localhost:8080/v1

# vLLM Configuration (local OpenAI-compatible server)
# DEFAULT_LLM_PROVIDER=vllm
# DEFAULT_LLM_MODEL=unsloth/Qwen3.5-27B-GGUF
# VLLM_BASE_URL=http://localhost:8000/v1

# SGLang Configuration (local OpenAI-compatible server)
# DEFAULT_LLM_PROVIDER=sglang
# DEFAULT_LLM_MODEL=Qwen/Qwen3.5-27B-FP8
# SGLANG_BASE_URL=http://localhost:30000/v1

# Embedding Model (for dense search channel)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
